/// Initialize the contract state with Treasury support
#[no_mangle]
pub extern "C" fn init_contract(context: &mut Context) -> Result<bool, String> {
    // Check if contract is already initialized
    let initialized = context.get_typed::<bool>(CONTRACT_INITIALIZED_KEY)
        .unwrap_or(Ok(false))
        .unwrap_or(false);
        
    if initialized {
        return Ok(true); // Already initialized
    }
    
    // Initialize token store
    let token_store = TokenStore {
        tokens: HashMap::new(),
        owner_tokens: HashMap::new(),
    };
    context.store(TOKEN_STORE_KEY, &token_store)?;
    
    // Initialize asset registry
    let asset_registry = AssetRegistry {
        assets: HashMap::new(),
    };
    context.store(ASSET_REGISTRY_KEY, &asset_registry)?;
    
    // Initialize attestation accumulator
    let accumulator = AttestationAccumulator::new();
    context.store(ATTESTATION_ACCUMULATOR_KEY, &accumulator)?;
    
    // Initialize verification metrics
    let verification_metrics = VerificationMetrics::default();
    context.set_typed(VERIFICATION_METRICS_KEY, &verification_metrics);
    
    // Mark contract as initialized
    context.set_typed(CONTRACT_INITIALIZED_KEY, &true);
    
    Ok(true)
}

/// Get token store reference
fn get_token_store(context: &mut Context) -> Result<TokenStore, String> {
    context.get::<TokenStore>(TOKEN_STORE_KEY).ok_or_else(|| "TokenStore not found".to_string())
}

/// Get asset registry reference
fn get_asset_registry(context: &mut Context) -> Result<AssetRegistry, String> {
    context.get::<AssetRegistry>(ASSET_REGISTRY_KEY).ok_or_else(|| "AssetRegistry not found".to_string())
}

/// Get attestation accumulator reference
fn get_attestation_accumulator(context: &mut Context) -> Result<AttestationAccumulator, String> {
    context.get::<AttestationAccumulator>(ATTESTATION_ACCUMULATOR_KEY).ok_or_else(|| "AttestationAccumulator not found".to_string())
}

/// Get verification metrics reference
fn get_verification_metrics(context: &mut Context) -> Result<VerificationMetrics, String> {
    context.get::<VerificationMetrics>(VERIFICATION_METRICS_KEY).ok_or_else(|| "VerificationMetrics not found".to_string())
}

/// Update verification metrics
fn update_verification_metrics(context: &mut Context, verification_time: u64, verification_type: &str) -> Result<(), String> {
    let mut metrics = get_verification_metrics(context)?;
    
    metrics.verification_count += 1;
    metrics.total_verification_time_ms += verification_time;
    
    // Update average verification time
    metrics.avg_verification_time_ms = metrics.total_verification_time_ms as f64 / metrics.verification_count as f64;
    
    // Update fastest/slowest metrics
    if metrics.fastest_verification_ms == 0 || verification_time < metrics.fastest_verification_ms {
        metrics.fastest_verification_ms = verification_time;
    }
    
    if verification_time > metrics.slowest_verification_ms {
        metrics.slowest_verification_ms = verification_time;
    }
    
    // Update verification by type
    *metrics.verification_by_type.entry(verification_type.to_string()).or_insert(0) += 1;
    
    // Save updated metrics
    context.set(VERIFICATION_METRICS_KEY, &metrics);
    
    Ok(())
}

/// Ensure contract is initialized
fn ensure_initialized(context: &mut Context) -> Result<bool, String> {
    // Check if contract is already initialized
    let initialized = context.get_typed::<bool>(CONTRACT_INITIALIZED_KEY)
        .unwrap_or(Ok(false))
        .unwrap_or(false);
        
    if initialized {
        return Ok(true); // Already initialized
    }
    
    // Initialize the contract
    init_contract(context)
}

/// Store a transaction in the contract state
fn store_transaction(context: &mut Context, transaction: Transaction) -> Result<(), String> {
    // Generate a unique key for the transaction
    let transaction_key = format!("tx:{}", transaction.id).as_bytes().to_vec();
    
    // Store the transaction
    context.set_typed(&transaction_key, &transaction);
    
    Ok(())
}

/// Create a token from a Treasury asset
fn token_from_treasury(treasury_asset: &treasury::TreasuryAsset, owner: &str, amount: f64, proof: TokenizationProof, timestamp: u64) -> Token {
    // Generate a unique token ID
    let token_id = format!("token:{}-{}-{}", treasury_asset.base.symbol, owner, uuid::Uuid::new_v4().to_string());
    
    Token {
        id: token_id,
        asset_symbol: treasury_asset.base.symbol.clone(),
        owner: owner.to_string(),
        amount,
        proof,
        creation_timestamp: timestamp,
        last_update_timestamp: timestamp,
        parent_token_id: None,
        is_fractionalized: false,
    }
}

/// Generate a unique ID
fn generate_id(prefix: &str) -> String {
    let mut hasher = Sha256::new();
    
    // Get some randomness
    let mut random_bytes = [0u8; 16];
    let _ = getrandom::getrandom(&mut random_bytes);
    
    // Current timestamp for uniqueness
    let timestamp = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs();
    
    hasher.update(random_bytes);
    hasher.update(timestamp.to_be_bytes());
    
    let result = hasher.finalize();
    format!("{}-{}", prefix, hex::encode(&result[..8]))
}

/// Generate a unique token ID using the token's data
fn create_token_id(token: &Token) -> String {
    let mut token_data = format!("{}{}{}{}", 
        token.asset_symbol, 
        token.owner, 
        token.amount, 
        token.issued_at
    );
    
    // Include fraction precision in token ID generation
    token_data.push_str(&format!("{}", token.fraction_precision));
    
    // Include parent token reference if available for ownership tracking
    if let Some(ref parent) = token.parent_token_id {
        token_data.push_str(parent);
    }
    
    hash_data(&token_data)
}

/// Helper function to hash data
fn hash_data(data: &str) -> String {
    let mut hasher = Sha256::new();
    hasher.update(data.as_bytes());
    let result = hasher.finalize();
    hex::encode(&result)
}
    // Helper function to validate fractional amounts
    fn validate_fractional_amount(amount: f64) -> bool {
        // Allow positive amounts with up to 6 decimal places
        amount > 0.0 && (amount * 1_000_000.0).fract() == 0.0
    }
    
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Validate asset data
    if request.symbol.is_empty() {
        return Err("Asset symbol cannot be empty".to_string());
    }
    
    if request.owner.is_empty() {
        return Err("Owner address cannot be empty".to_string());
    }
    
    if !validate_fractional_amount(request.amount) {
        return Err("Invalid amount: must be positive with up to 6 decimal places".to_string());
    }
    
    // Get asset registry
    let mut registry = get_asset_registry(context)?;
    
    // Check if the asset exists, create it if not
    let asset = if let Some(existing_asset) = registry.assets.get(&request.symbol) {
        existing_asset.clone()
    } else {
        // Create a new asset if it doesn't exist
        let new_asset = Asset {
            symbol: request.symbol.clone(),
            name: request.name.clone(),
            asset_type: AssetType::UserDefined,
            compliance: ComplianceInfo {
                status: ComplianceStatus::Compliant,
                jurisdiction: request.jurisdiction.clone().unwrap_or_default(),
                last_updated: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_secs(),
            },
            metadata: request.metadata.clone(),
        };
        
        // Store the asset in the registry
        registry.assets.insert(request.symbol.clone(), new_asset.clone());
        
        // Update the asset registry
        context.set(ASSET_REGISTRY_KEY, &registry);
        
        new_asset
    };
    
    // Get token store
    let mut token_store = get_token_store(context)?;
    
    // Create token
    let token_id = generate_id("TKN");
    let token = Token {
        id: token_id.clone(),
        asset_symbol: request.symbol.clone(),
        name: asset.name.clone(),
        owner: request.owner.clone(),
        amount: request.amount,
        timestamp: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_secs(),
        proof: TokenizationProof {
            verified: true,
            verifier: "TEE".to_string(),
            hardware_verified: Some(true),
            timestamp: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_secs(),
        },
        metadata: request.metadata.clone(),
    };
    
    // Store token in token store
    token_store.tokens.insert(token_id.clone(), token.clone());
    
    // Add token to owner's tokens
    token_store.owner_tokens.entry(request.owner.clone())
        .or_insert_with(Vec::new)
        .push(token_id.clone());
    
    // Update token store
    context.store(TOKEN_STORE_KEY, &token_store)?;
    
    // Record the transaction
    let transaction = Transaction {
        id: generate_id("TRX"),
        token_id: token_id.clone(),
        transaction_type: TransactionType::Tokenize,
        from: "MINT".to_string(),
        to: request.owner.clone(),
        amount: request.amount,
        timestamp: std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_secs(),
        hash: calculate_tx_hash(&request.symbol, &request.owner, request.amount),
        metadata: request.metadata.clone(),
    };
    
    // Store transaction
    store_transaction(context, transaction)?;
    
    // Return the token
    Ok(token)
}

/// Process market data update
#[public]
pub fn process_market_data(context: &mut Context, update: MarketDataUpdate) -> Result<bool, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Validate update signature
    // In production, we'd verify a cryptographic signature
    if !update.signature.starts_with("SIG-") {
        return Err("Invalid market data signature".to_string());
    }
    
    // Get asset registry
    let mut asset_registry = get_asset_registry(context)?;
    // Update asset price
    for price_update in update.prices.iter() {
        if let Some(asset) = asset_registry.assets.get_mut(&price_update.symbol) {
            asset.current_price = price_update.price;
            asset.last_updated = update.timestamp;
        }
    }
    
    // Store updated asset registry
    context.store(ASSET_REGISTRY_KEY, &asset_registry)?;
    
    // Return success
    Ok(true)
}

/// Split a token into fractional pieces
#[public]
pub fn fractionalize_token(context: &mut Context, request: FractionalizeRequest) -> Result<Vec<Token>, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Get token store
    let mut token_store = get_token_store(context)?;
    
    // Check if token exists
    let token = match token_store.tokens.get(&request.token_id) {
        Some(t) => t.clone(),
        None => return Err(format!("Token {} not found", request.token_id)),
    };
    
    // Verify owner matches
    if token.owner != request.owner {
        return Err("Token owner mismatch - authorization failed".to_string());
    }
    
    // Validate total fraction amount matches token amount
    let total_allocation: f64 = request.fractions.iter().map(|f| f.amount).sum();
    if (total_allocation - token.amount).abs() > 0.000001 {
        return Err(format!(
            "Total allocation {} does not match token amount {}",
            total_allocation, token.amount
        ));
    }
    
    // TEE verification for fractionalization
    let mut accumulator = get_attestation_accumulator(context)?;
    let (verified, verification_time) = accumulator.verify_tees(
        &request.primary_tee_id,
        &request.secondary_tee_id,
        &request.region_id,
    );
    
    if !verified {
        return Err("TEE attestation verification failed".to_string());
    }
    
    // Record verification metrics
    update_verification_metrics(context, verification_time, "fractionalization")?;
    
    // Create fractional tokens
    let mut fractional_tokens = Vec::new();
    let parent_id = token.id.clone();
    let current_time = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs();
    
    for (i, fraction) in request.fractions.iter().enumerate() {
        let fraction_id = format!("{}-FRAC-{}", parent_id, i + 1);
        
        // Create tokenization proof for the fraction
        let proof = TokenizationProof {
            verified: true,
            verifier: "TEE-DUAL".to_string(),
            hardware_verified: Some(true),
            timestamp: current_time,
        };
        
        // Create the fractional token
        let fractional_token = Token {
            id: fraction_id.clone(),
            asset_symbol: token.asset_symbol.clone(),
            name: token.name.clone(),
            owner: fraction.recipient.clone(),
            amount: fraction.amount,
            timestamp: current_time,
            proof,
            metadata: token.metadata.clone(),
        };
        
        // Add fractional token to results
        fractional_tokens.push(fractional_token.clone());
        
        // Store the token
        token_store.tokens.insert(fraction_id.clone(), fractional_token.clone());
        
        // Add to recipient's tokens
        token_store.owner_tokens
            .entry(fraction.recipient.clone())
            .or_insert_with(Vec::new)
            .push(fraction_id.clone());
        
        // Create a transaction record
        let transaction = Transaction {
            id: generate_id("TRX"),
            token_id: fraction_id.clone(),
            transaction_type: TransactionType::Fractionalize,
            from: request.owner.clone(),
            to: fraction.recipient.clone(),
            amount: fraction.amount,
            timestamp: current_time,
            hash: calculate_tx_hash(&token.asset_symbol, &fraction.recipient, fraction.amount),
            metadata: token.metadata.clone(),
        };
        
        // Store transaction
        store_transaction(context, transaction)?;
    }
    
    // Update the token store
    context.store(TOKEN_STORE_KEY, &token_store)?;
    
    // Update the accumulator
    context.store(ATTESTATION_ACCUMULATOR_KEY, &accumulator)?;
    
    // Return the fractional tokens
    Ok(fractional_tokens)
}

/// Transfer a token between owners
#[public]
pub fn transfer_token(context: &mut Context, token_id: String, new_owner: String) -> Result<Token, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Get token store
    let mut token_store = get_token_store(context)?;
    
    // Find the token
    let token = match token_store.tokens.get(&token_id) {
        Some(token) => token.clone(),
        None => return Err(format!("Token {} not found", token_id))
    };
    
    // Update token ownership
    let current_owner = token.owner.clone();
    
    // Remove token from current owner's list
    if let Some(token_ids) = token_store.owner_tokens.get_mut(&current_owner) {
        token_ids.retain(|id| id != &token_id);
    }
    
    // Add token to new owner's list
    token_store.owner_tokens.entry(new_owner.clone())
        .or_insert_with(Vec::new)
        .push(token_id.clone());
    
    // Update token with new owner
    let mut updated_token = token;
    updated_token.owner = new_owner;
    
    // Save updated token
    token_store.tokens.insert(token_id, updated_token.clone());
    
    // Update token store in context
    context.store(TOKEN_STORE_KEY, &token_store)?;
    
    Ok(updated_token)
}

/// Get asset information
#[public]
pub fn get_asset_info(context: &mut Context, symbol: String) -> Result<Asset, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Get asset registry
    let registry = get_asset_registry(context)?;
    
    // Find the asset
    if let Some(asset) = registry.assets.get(&symbol) {
        Ok(asset.clone())
    } else {
        Err(format!("Asset {} not found", symbol))
    }
}

/// Get tokens owned by a specific address
#[no_mangle]
#[public]
pub fn get_owner_tokens(context: &mut Context, owner_address: String) -> Result<Vec<Token>, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Get token store
    let token_store = get_token_store(context)?;
    
    // Get tokens owned by the address
    let mut tokens = Vec::new();
    
    if let Some(token_ids) = token_store.owner_tokens.get(&owner_address) {
        // Collect token details
        for token_id in token_ids {
            if let Some(token) = token_store.tokens.get(token_id) {
                tokens.push(token.clone());
            }
        }
    }
    
    Ok(tokens)
}

/// Helper function to read input data from memory
fn read_input(data_ptr: u32, data_len: u32) -> String {
    let data = unsafe {
        let slice = std::slice::from_raw_parts(data_ptr as *const u8, data_len as usize);
        String::from_utf8_lossy(slice).to_string()
    };
    
    data
}

/// Helper function to write response data to memory
fn write_response(response: &ResponseData) -> u32 {
    let response_json = serde_json::to_string(response).unwrap_or_default();
    let response_bytes = response_json.as_bytes();
    let len = response_bytes.len();
    
    // Allocate memory for the response
    let mut result = Vec::with_capacity(len);
    result.extend_from_slice(response_bytes);
    
    // Convert vector into raw parts - the data pointer will be returned, while length and capacity are leaked
    // This is intentional as we're returning the pointer to WASM host
    let result_ptr = result.as_mut_ptr();
    std::mem::forget(result);
    
    // Return pointer to the response data
    result_ptr as u32
}

/// Helper function to create an error response
fn create_error_response(error_message: &str) -> u32 {
    let response = ResponseData {
        success: false,
        message: "Error occurred".to_string(),
        data: None,
        error: Some(error_message.to_string()),
    };
    
    write_response(&response)
}

/// Helper function to calculate transaction hash
fn calculate_tx_hash(asset_symbol: &str, owner: &str, amount: f64) -> String {
    let mut hasher = Sha256::new();
    
    hasher.update(asset_symbol.as_bytes());
    hasher.update(owner.as_bytes());
    hasher.update(amount.to_string().as_bytes());
    
    let timestamp = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs();
    
    hasher.update(timestamp.to_be_bytes());
    
    let result = hasher.finalize();
    hex::encode(result)
}

/// Helper function to calculate update hash
fn calculate_update_hash(symbol: &str, price: f64, timestamp: u64) -> String {
    let mut hasher = Sha256::new();
    
    hasher.update(symbol.as_bytes());
    hasher.update(price.to_string().as_bytes());
    hasher.update(timestamp.to_be_bytes());
    
    let result = hasher.finalize();
    hex::encode(result)
}

// Memory management is handled by the WASM runtime

/// TEE registration request structure
#[derive(Serialize, Deserialize, Clone, Debug, BorshSerialize, BorshDeserialize)]
#[state_schema(TeeRegistrationRequest)]
pub struct TeeRegistrationRequest {
    /// TEE ID
    pub tee_id: String,
    /// Region ID for regulatory compliance
    pub region_id: String,
    /// TEE type ("sgx" or "amd")
    pub tee_type: String,
    /// TEE measurement hash (64 hex characters)
    pub measurement_hash: String,
    /// TEE software version
    pub version: String,
}

/// Register TEE to the attestation accumulator
/// This optimized function enables direct management of the cryptographic accumulator
#[public]
pub fn register_tee_to_accumulator(context: &mut Context, request: TeeRegistrationRequest) -> Result<AttestationAccumulator, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Start measuring verification time for performance metrics
    let verification_start = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_millis() as u64;
    
    // Determine if this is a primary (Intel SGX) or secondary (AMD SEV) TEE
    let is_primary = match request.tee_type.as_str() {
        "sgx" => true,
        "amd" => false,
        _ => return Err("Invalid TEE type: must be 'sgx' or 'amd'".to_string())
    };
    
    // Validate measurement hash (must be 64 hex characters)
    if !request.measurement_hash.chars().all(|c| c.is_ascii_hexdigit()) || request.measurement_hash.len() != 64 {
        return Err("Invalid measurement hash format: must be 64 hex characters".to_string());
    }
    
    // Get the attestation accumulator
    let mut accumulator = get_attestation_accumulator(context)?;
    
    // Add the TEE to the accumulator with constant-time operations
    let success = accumulator.add_tee(&request.tee_id, &request.region_id, is_primary);
    
    if !success {
        return Err("Failed to add TEE to accumulator".to_string());
    }
    
    // Update the accumulator in the contract state
    context.store(ATTESTATION_ACCUMULATOR_KEY, &accumulator)?;
    
    // Calculate verification time
    let verification_end = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_millis() as u64;
    let verification_time = verification_end - verification_start;
    
    // Update verification metrics
    let verification_type = format!("tee-registration-{}", if is_primary { "sgx" } else { "amd" });
    update_verification_metrics(context, verification_time, &verification_type)?;
    
    // Return the updated accumulator
    Ok(accumulator)
}

/// Cross-attestation verification request
#[derive(Serialize, Deserialize, Clone, Debug, BorshSerialize, BorshDeserialize)]
#[state_schema(VerificationRequest)]
pub struct VerificationRequest {
    /// Primary TEE (Intel SGX) ID
    pub primary_tee_id: String,
    /// Secondary TEE (AMD SEV) ID
    pub secondary_tee_id: String,
    /// Region ID for regulatory compliance
    pub region_id: String,
}

/// Cross-attestation verification result
#[derive(Serialize, Deserialize, Clone, Debug, BorshSerialize, BorshDeserialize)]
#[state_schema(CrossAttestationResult)]
pub struct CrossAttestationResult {
    /// Verification success
    pub success: bool,
    /// Verification time in milliseconds
    pub verification_time_ms: u64,
    /// Accumulator value after verification
    pub accumulator_value: String,
    /// Total processing time including state operations
    pub total_processing_time_ms: u64,
}

/// Verify cross-attestation directly using the cryptographic accumulator
/// This allows efficient verification without tokenizing an asset
#[public]
pub fn verify_cross_attestation(context: &mut Context, request: VerificationRequest) -> Result<CrossAttestationResult, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Start measuring verification time for performance metrics
    let verification_start = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_millis() as u64;
    
    // Get the attestation accumulator
    let mut accumulator = get_attestation_accumulator(context)?;
    
    // Verify the TEEs against the accumulator using constant-time operations
    // This provides O(1) verification complexity through the cryptographic accumulator
    let (success, verification_time) = accumulator.verify_tees(
        &request.primary_tee_id,
        &request.secondary_tee_id,
        &request.region_id
    );
    
    if !success {
        return Err("Cross-attestation verification failed".to_string());
    }
    
    // Update the accumulator in the contract state
    context.store(ATTESTATION_ACCUMULATOR_KEY, &accumulator)?;
    
    // Calculate total verification time
    let verification_end = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_millis() as u64;
    let total_verification_time = verification_end - verification_start;
    
    // Update verification metrics
    update_verification_metrics(context, verification_time, "cross-attestation")?;
    
    // Create and return the result
    let result = CrossAttestationResult {
        success,
        verification_time_ms: verification_time,
        accumulator_value: accumulator.value,
        total_processing_time_ms: total_verification_time,
    };
    
    Ok(result)
}

/// Treasury tokenization request structure
#[derive(Serialize, Deserialize, Clone, Debug, BorshSerialize, BorshDeserialize)]
#[state_schema(TreasuryTokenizationRequest)]
pub struct TreasuryTokenizationRequest {
    /// CUSIP identifier
    pub cusip: String,
    /// Treasury name
    pub name: String,
    /// Treasury type (Bill, Note, Bond, TIPS)
    pub treasury_type: String,
    /// Maturity in years
    pub maturity_years: f64,
    /// Coupon rate percentage
    pub coupon_rate: f64,
    /// Token owner address
    pub owner: String,
    /// Token amount
    pub amount: f64,
    /// Regulatory region ID
    pub region_id: String,
    /// Primary TEE (Intel SGX) ID
    pub primary_tee_id: String,
    /// Secondary TEE (AMD SEV) ID
    pub secondary_tee_id: String,
    /// Current market price
    pub current_price: f64,
    /// Fraction precision
    pub fraction_precision: u8,
}

/// Tokenize US Treasury security with optimized cross-attestation verification
/// Uses the cryptographic accumulator for efficient verification
#[public]
pub fn tokenize_treasury_asset(context: &mut Context, request: TreasuryTokenizationRequest) -> Result<Token, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Start measuring verification time for performance metrics
    let verification_start = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_millis() as u64;
    
    // Parse Treasury type
    let treasury_type = match request.treasury_type.as_str() {
        "Bill" => treasury::TreasuryType::Bill,
        "Note" => treasury::TreasuryType::Note,
        "Bond" => treasury::TreasuryType::Bond,
        "TIPS" => treasury::TreasuryType::TIPS,
        _ => return Err("Invalid Treasury type".to_string())
    };
    
    // Validate input parameters using constant-time comparisons for side-channel protection
    if !(1..=30).contains(&(request.maturity_years as i32)) {
        return Err("Maturity years must be between 1 and 30".to_string());
    }
    
    if !(0.0..=15.0).contains(&request.coupon_rate) {
        return Err("Coupon rate must be between 0 and 15 percent".to_string());
    }
    
    if !(1.0..=10_000_000.0).contains(&request.amount) {
        return Err("Amount must be between 1 and 10,000,000".to_string());
    }
    
    if !(0..=8).contains(&request.fraction_precision) {
        return Err("Fraction precision must be between 0 and 8".to_string());
    }
    
    // Create the asset symbol based on Treasury type
    let asset_symbol = match treasury_type {
        treasury::TreasuryType::Bill => format!("TBILL-{}", request.cusip),
        treasury::TreasuryType::Note => format!("TNOTE-{}", request.cusip),
        treasury::TreasuryType::Bond => format!("TBOND-{}", request.cusip),
        treasury::TreasuryType::TIPS => format!("TIPS-{}", request.cusip),
    };
    
    // Get asset registry for create/lookup
    let mut asset_registry = get_asset_registry(context)?;
    
    // Create or retrieve the Treasury asset
    let treasury_asset = if asset_registry.assets.contains_key(&asset_symbol) {
        // Asset exists, use existing asset
        let base_asset = asset_registry.assets.get(&asset_symbol).unwrap().clone();
        
        // Create TreasuryAsset from base Asset
        treasury::create_treasury_asset(
            &request.cusip,
            &request.name,
            treasury_type,
            request.maturity_years,
            request.coupon_rate,
            request.current_price,
            &request.region_id
        )
    } else {
        // Create new Treasury asset
        let treasury_asset = treasury::create_treasury_asset(
            &request.cusip,
            &request.name,
            treasury_type,
            request.maturity_years,
            request.coupon_rate,
            request.current_price,
            &request.region_id
        );
        
        // Register the base asset
        asset_registry.assets.insert(asset_symbol.clone(), treasury_asset.base.clone());
        
        // Update asset registry in contract state
        context.store(ASSET_REGISTRY_KEY, &asset_registry)?;
        
        treasury_asset
    };
    
    // Get the attestation accumulator for efficient verification
    let mut accumulator = get_attestation_accumulator(context)?;
    
    // Perform cross-attestation verification using the accumulator
    let (verification_success, verification_time) = accumulator.verify_tees(
        &request.primary_tee_id,
        &request.secondary_tee_id,
        &request.region_id
    );
    
    if !verification_success {
        return Err("Cross-attestation verification failed".to_string());
    }
    
    // Update accumulator in state
    context.store(ATTESTATION_ACCUMULATOR_KEY, &accumulator)?;
    
    // Get current timestamp
    let now = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .unwrap_or_default()
        .as_secs();
    
    // Create token proof with dual-TEE attestation
    let proof = TokenizationProof {
        primary_attestation: format!("sgx:{}", request.primary_tee_id),
        secondary_attestation: format!("amd:{}", request.secondary_tee_id),
        accumulator_value: accumulator.value.clone(),
        region_id: request.region_id.clone(),
        timestamp: now,
        verified: true,
        hardware_verified: Some(true),
        version_verified: Some(true),
    };
    
    // Create the token for the Treasury asset
    let token = token_from_treasury(
        &treasury_asset,
        &request.owner,
        request.amount,
        proof,
        now
    );
    
    // Add token to the store
    let mut token_store = get_token_store(context)?;
    token_store.tokens.insert(token.id.clone(), token.clone());
    
    // Update token store in context
    context.store(TOKEN_STORE_KEY, &token_store)?;
    
    // Create transaction record
    let transaction = Transaction {
        id: generate_id("tx"),
        tx_type: TransactionType::Tokenize,
        sender: None,
        receiver: Some(request.owner.clone()),
        asset_symbol: asset_symbol.clone(),
        amount: request.amount,
        timestamp: now,
        verified: true,
        hash: calculate_tx_hash(&asset_symbol, &request.owner, request.amount),
    };
    
    // Store transaction in logs
    store_transaction(context, transaction)?;
    
    // Update verification metrics
    update_verification_metrics(context, verification_time, &format!("treasury-{:?}", treasury_type))?;
    
    // Return the created token
    Ok(token.clone())
}

/// Get Treasury benchmark metrics
#[public]
pub fn get_treasury_verification_metrics(context: &mut Context) -> Result<VerificationMetrics, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Get verification metrics from contract state
    let metrics = get_verification_metrics(context)?;
    
    // Return the verification metrics
    Ok(metrics)
}
