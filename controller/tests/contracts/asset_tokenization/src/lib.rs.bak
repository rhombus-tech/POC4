/// Process Treasury market data for the NASDAQ simulation
/// This function handles incoming market data updates for treasury assets
#[public]
pub fn process_treasury_market_data(context: &mut Context, data: TreasuryMarketData) -> Result<MarketUpdateResult, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Get asset registry
    let mut asset_registry = get_asset_registry(context)?;
    
    // Start time tracking
    let timestamp = get_current_timestamp();
    
    // Verify the market data through the dual TEE architecture
    let mut accumulator = get_attestation_accumulator(context)?;
    
    // Perform cross-attestation verification
    let (verified, verification_time) = accumulator.verify_tees(
        &data.primary_tee_id,
        &data.secondary_tee_id,
        &data.region_id,
    );
    
    if !verified {
        return Err("Market data verification failed: Cross-attestation failed".to_string());
    }
    
    // Update verification metrics
    update_verification_metrics(context, verification_time, "market_data")?;
    
    // Update the asset price if it exists, otherwise create a new asset
    let asset_key = data.cusip.clone();
    let treasury_asset = if let Some(existing_asset) = asset_registry.assets.get(&asset_key) {
        // Update existing asset with new price data
        let mut updated_asset = existing_asset.clone();
        updated_asset.treasury_info.current_price = data.price;
        updated_asset.base.current_price = data.price;
        updated_asset.base.last_update_timestamp = timestamp;
        updated_asset
    } else {
        // Create a new Treasury asset
        let treasury_type = match data.treasury_type.as_str() {
            "BILL" => treasury::TreasuryType::Bill,
            "NOTE" => treasury::TreasuryType::Note,
            "BOND" => treasury::TreasuryType::Bond,
            "TIP" => treasury::TreasuryType::TIPS,
            _ => return Err(format!("Unknown Treasury type: {}", data.treasury_type)),
        };
        
        // Create the new asset
        treasury::create_treasury_asset(
            data.cusip,
            data.name,
            treasury_type,
            data.maturity_years,
            data.coupon_rate,
            data.price,
            timestamp,
        )
    };
    
    // Save updated asset to registry
    asset_registry.assets.insert(asset_key.clone(), treasury_asset.clone());
    context.store(AssetRegistry, &asset_registry)
        .map_err(|e| format!("Failed to store asset registry: {}", e))?;
    
    // Create the market update result
    let result = MarketUpdateResult {
        cusip: asset_key,
        price: data.price,
        timestamp,
        verification_time_ms: verification_time,
        market_status: "active".to_string(),
    };
    
    Ok(result)
};
    context.store(AssetRegistry, &asset_registry)
        .map_err(|e| format!("Failed to store asset registry: {}", e))?;
    
    // Initialize attestation accumulator
    let accumulator = AttestationAccumulator::new();
    context.store(AttestationAccumulator, &accumulator)
        .map_err(|e| format!("Failed to store accumulator: {}", e))?;
    
    // Initialize verification metrics
    let verification_metrics = VerificationMetrics::default();
    context.store(VerificationMetrics, &verification_metrics)
        .map_err(|e| format!("Failed to store metrics: {}", e))?;
    
    // Mark contract as initialized
    context.store(ContractInitialized, &true)
        .map_err(|e| format!("Failed to mark contract as initialized: {}", e))?;
    
    Ok(true)
}

/// Tokenize US Treasury security with optimized cross-attestation verification
/// Uses the cryptographic accumulator for efficient verification
/// Get token store reference
fn get_token_store(context: &mut Context) -> Result<TokenStore, String> {
    Ok(context.get(TokenStore)
        .map_err(|e| format!("Failed to get token store: {}", e))?        
        .unwrap_or_default())
}

/// Get asset registry reference
fn get_asset_registry(context: &mut Context) -> Result<AssetRegistry, String> {
    Ok(context.get(AssetRegistry)
        .map_err(|e| format!("Failed to get asset registry: {}", e))?        
        .unwrap_or_default())
}

/// Get attestation accumulator reference
fn get_attestation_accumulator(context: &mut Context) -> Result<AttestationAccumulator, String> {
    Ok(context.get(AttestationAccumulator)
        .map_err(|e| format!("Failed to get attestation accumulator: {}", e))?        
        .unwrap_or_else(AttestationAccumulator::new))
}

/// Get verification metrics reference
fn get_verification_metrics(context: &mut Context) -> Result<VerificationMetrics, String> {
    Ok(context.get(VerificationMetrics)
        .map_err(|e| format!("Failed to get verification metrics: {}", e))?        
        .unwrap_or_default())
}

/// Update verification metrics
fn update_verification_metrics(context: &mut Context, verification_time: u64, verification_type: &str) -> Result<(), String> {
    // Get current metrics
    let mut metrics = get_verification_metrics(context)?;
    
    // Update metrics
    metrics.verification_count += 1;
    metrics.total_verification_time += verification_time;
    
    if verification_time < metrics.min_verification_time || metrics.min_verification_time == 0 {
        metrics.min_verification_time = verification_time;
    }

/// Process Treasury market data for the NASDAQ simulation
/// This function handles incoming market data updates for treasury assets
#[public]
pub fn process_treasury_market_data(context: &mut Context, data: TreasuryMarketData) -> Result<MarketUpdateResult, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Get asset registry
    let mut asset_registry = get_asset_registry(context)?;
    
    // Start time tracking
    let timestamp = get_current_timestamp();
    
    // Verify the market data through the dual TEE architecture
    let mut accumulator = get_attestation_accumulator(context)?;
    
    // Perform cross-attestation verification
    let (verified, verification_time) = accumulator.verify_tees(
        &data.primary_tee_id,
        &data.secondary_tee_id,
        &data.region_id,
    );
    
    if !verified {
        return Err("Market data verification failed: Cross-attestation failed".to_string());
    }
    
    // Update verification metrics
    update_verification_metrics(context, verification_time, "market_data")?;
    
    // Update the asset price if it exists, otherwise create a new asset
    let asset_key = data.cusip.clone();
    let treasury_asset = if let Some(existing_asset) = asset_registry.assets.get(&asset_key) {
        // Update existing asset with new price data
        let mut updated_asset = existing_asset.clone();
        updated_asset.treasury_info.current_price = data.price;
        updated_asset.base.current_price = data.price;
        updated_asset.base.last_update_timestamp = timestamp;
        updated_asset
    } else {
        // Create a new Treasury asset
        let treasury_type = match data.treasury_type.as_str() {
            "BILL" => treasury::TreasuryType::Bill,
            "NOTE" => treasury::TreasuryType::Note,
            "BOND" => treasury::TreasuryType::Bond,
            "TIP" => treasury::TreasuryType::TIPS,
            _ => return Err(format!("Unknown Treasury type: {}", data.treasury_type)),
        };
        
        // Create the new asset
        treasury::create_treasury_asset(
            data.cusip,
            data.name,
            treasury_type,
            data.maturity_years,
            data.coupon_rate,
            data.price,
            timestamp,
        )
    };
    
    // Save updated asset to registry
    asset_registry.assets.insert(asset_key.clone(), treasury_asset.clone());
    context.store(AssetRegistry, &asset_registry)
        .map_err(|e| format!("Failed to store asset registry: {}", e))?;
    
    // Create the market update result
    let result = MarketUpdateResult {
        cusip: asset_key,
        price: data.price,
        timestamp,
        verification_time_ms: verification_time,
        market_status: "active".to_string(),
    };
    
    Ok(result)
}
    
    if verification_time > metrics.max_verification_time {
        metrics.max_verification_time = verification_time;
    }

