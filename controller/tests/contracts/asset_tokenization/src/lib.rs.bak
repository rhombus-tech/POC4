    };
    
    Ok(result)
}
    
    /// Add a TEE to the accumulator using constant-time operations
    pub fn add_tee(&mut self, tee_id: &str, region_id: &str, is_primary: bool) -> bool {
        // Get the current timestamp
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs();
        
        // Create or update regional verification data
        let regional_data = self.regional_data.entry(region_id.to_string())
            .or_insert(RegionalVerification {
                region_id: region_id.to_string(),
                accumulator_value: self.value.clone(),
                tee_count: 0,
                last_verification: now,
                compliance_status: ComplianceStatus::Compliant,
            }

