    };
    
    Ok(result)
}
    
    // Update type-specific metrics
    *metrics.verification_by_type.entry(verification_type.to_string()).or_insert(0) += 1;
    
    // Save updated metrics
    context.store(VerificationMetrics, &metrics)
        .map_err(|e| format!("Failed to update verification metrics: {}", e))?;
    
    Ok(())
}

/// Ensure contract is initialized
fn ensure_initialized(context: &mut Context) -> Result<bool, String> {
    // Check if contract is initialized
    let initialized = context.get(ContractInitialized)
        .map_err(|_| "Failed to check initialization status".to_string())?
        .unwrap_or(false);
    
    if !initialized {
        return Err("Contract not initialized".to_string());
    }

