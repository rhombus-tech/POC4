/// Token store for managing tokens
#[derive(Serialize, Deserialize, Clone, Debug, Default, BorshSerialize, BorshDeserialize)]
pub struct TokenStore {
    /// Map of token ID to token
    pub tokens: HashMap<String, Token>,
    /// Map of owner address to token IDs
    pub owner_tokens: HashMap<String, Vec<String>>,
}

/// Asset registry for managing assets
#[derive(Serialize, Deserialize, Clone, Debug, Default, BorshSerialize, BorshDeserialize)]
pub struct AssetRegistry {
    /// Map of asset symbol to asset
    pub assets: HashMap<String, Asset>,
}

/// Input for tokenization request
#[derive(Serialize, Deserialize, Debug, BorshSerialize, BorshDeserialize)]
pub struct TokenizationRequest {
    /// Asset symbol to tokenize
    asset_symbol: String,
    /// Owner's public key
    owner: String,
    /// Amount to tokenize
    amount: f64,
    /// Region ID (e.g., "us-east-1")
    region_id: String,
    /// Primary TEE ID (e.g., "worker-sgx")
    primary_tee_id: String,
    /// Secondary TEE ID (e.g., "worker-sev")
    secondary_tee_id: String,
    /// Optional fractional precision (defaults to 6 if not specified)
    fraction_precision: Option<u8>,
    /// Optional parent token reference for fractionalization from existing tokens
    parent_token_id: Option<String>,
}

/// Input for market data update
#[derive(Serialize, Deserialize, Debug, BorshSerialize, BorshDeserialize)]
pub struct MarketDataUpdate {
    pub symbol: String,
    pub price: f64,
    pub timestamp: u64,
    pub source: Option<String>,
    pub metadata: Option<HashMap<String, String>>,
}

/// Fractionalization allocation information
#[derive(Serialize, Deserialize, Clone, Debug, BorshSerialize, BorshDeserialize)]
pub struct FractionAllocation {
    pub recipient: String,
    pub amount: f64,
}

/// Input for token fractionalization request
#[derive(Serialize, Deserialize, Clone, Debug, BorshSerialize, BorshDeserialize)]
pub struct FractionalizeRequest {
    pub token_id: String,      // Unique identifier of existing token
    pub owner: String,         // Must match current token owner
    pub allocations: Vec<FractionAllocation>, // Allocation of fractional tokens
    pub metadata: HashMap<String, String>, // Additional metadata (optional)
    pub primary_tee_id: String,
    pub secondary_tee_id: String,
}

/// Order book data
#[derive(Serialize, Deserialize, Clone, Debug, BorshSerialize, BorshDeserialize)]
pub struct OrderBook {
    /// Buy orders
    bids: Vec<Order>,
    /// Sell orders
    asks: Vec<Order>,
}

/// Order information
#[derive(Serialize, Deserialize, Clone, Debug, BorshSerialize, BorshDeserialize)]
pub struct Order {
    /// Order price
    price: f64,
    /// Order size
    size: u64,
}

/// Response structure
#[derive(Serialize, Deserialize, Debug, BorshSerialize, BorshDeserialize)]
pub struct ResponseData {
    /// Success status
    success: bool,
    /// Response message
    message: String,
    /// Response data (JSON string)
    data: Option<String>,
    /// Error information if any
    error: Option<String>,
}

/// Initialize the contract state with Treasury support
#[public]
pub fn init_contract(context: &mut Context) -> Result<bool, String> {
    // Check if contract is already initialized
    let initialized = context.get(ContractInitialized)
        .map_err(|_| "Failed to check initialization status".to_string())?
        .unwrap_or(false);
    
    if initialized {
        return Err("Contract is already initialized".to_string());
    }

