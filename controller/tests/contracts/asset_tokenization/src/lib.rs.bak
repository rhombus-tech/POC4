/// Store a transaction in the contract state
fn store_transaction(context: &mut Context, transaction: Transaction) -> Result<(), String> {
    // Create a transaction key using the ID
    let key = format!("transaction:{}", transaction.id);
    
    // Store the transaction with the key - use store directly
    let transaction_bytes = transaction.try_to_vec().map_err(|e| format!("Serialization error: {}", e))?;
    context.store(key.as_bytes(), &transaction_bytes)
        .map_err(|e| format!("Failed to store transaction: {}", e))?;
    
    Ok(())
}

/// Split a token into fractional pieces
#[public]
pub fn fractionalize_token(context: &mut Context, request: FractionalizeRequest) -> Result<Vec<Token>, String> {
    // Ensure contract is initialized
    ensure_initialized(context)?;
    
    // Get token store
    let mut token_store = get_token_store(context)?;
    
    // Check if token exists
    let token = match token_store.tokens.get(&request.token_id) {
        Some(t) => t.clone(),
        None => return Err(format!("Token {} not found", request.token_id)),
    }

